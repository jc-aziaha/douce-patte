ENVIRONMENT=development

# Développement/test : Mailtrap (sandbox SMTP). Production : Brevo (relais SMTP,
# société française — hébergement des données en France), mêmes variables.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

FROM_EMAIL=Douce Patte <contact@douce-patte.fr>
NOTIFY_EMAIL=contact@douce-patte.fr

# Laisser vide en développement pour ignorer la vérification reCAPTCHA
# (le honeypot reste actif).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

CORS_ALLOW_ORIGINS=["http://localhost:8123","https://douce-patte.fr"]

FRONTEND_DIST_DIR=../frontend/dist

# ----- Chatbot IA (RAG) — voir 12-specifications-techniques-chatbot-ia.md -----
# Fournisseur : Google Gemini (API AI Studio) — palier gratuit sans carte
# bancaire. Clé à créer sur https://aistudio.google.com/apikey. Utilisée à la
# fois par le serveur (endpoint /chat) et par scripts/build_index.py (calcul
# des embeddings du corpus, en local). Laisser vide en développement pour que
# le chatbot réponde systématiquement en repli, sans jamais lever d'erreur.
# Écart par rapport à la v2.0 de 12-specifications-techniques-chatbot-ia.md
# (qui retenait Mistral) : à documenter côté cadrage si ce choix est confirmé.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

KNOWLEDGE_INDEX_PATH=data/knowledge_index.npz

CHAT_RELEVANCE_THRESHOLD=0.55
CHAT_TOP_K=4
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT_WINDOW_SECONDS=300
CHAT_RATE_LIMIT_MAX_REQUESTS=10
CHAT_DAILY_REQUEST_CAP=200
