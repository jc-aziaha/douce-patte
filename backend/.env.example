ENVIRONMENT=development

# Développement/test : Mailtrap (sandbox SMTP). Production : Brevo (relais SMTP,
# société française — hébergement des données en France), mêmes variables.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

FROM_EMAIL=Douce Patte <contact@douce-patte.fr>
NOTIFY_EMAIL=contact@douce-patte.fr

# Laisser vide en développement pour ignorer la vérification reCAPTCHA
# (le honeypot reste actif).
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

CORS_ALLOW_ORIGINS=["http://localhost:8123","https://douce-patte.fr"]

FRONTEND_DIST_DIR=../frontend/dist
